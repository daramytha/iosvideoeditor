<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Top Bar (Header) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="〈"
            android:textColor="#FFCC00"
            android:textSize="22sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="VIDEO"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/btnAudio"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:text="🔊"
            android:gravity="center" />
    </LinearLayout>

    <!-- Area Preview Video (Mockup Kotak Tengah) -->
    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="260dp"
        android:layout_height="380dp"
        android:layout_centerInPerson="true"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:background="#1C1C1E">

        <!-- Simulasi Video Placeholder -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#2C2C2E" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Video Preview Area"
            android:textColor="#8E8E93"
            android:textSize="14sp" />
    </FrameLayout>

    <!-- Bottom Controls & Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Timeline / Filmstrip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="#161618"
            android:gravity="center"
            android:layout_marginBottom="16dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="||| Frame Timeline Simulator |||"
                android:textColor="#636366"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Tool Selection Icons Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️   💡   ✂️   🎨"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Bottom Action Bar (Cancel & Done) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnDone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Done"
                android:textColor="#FFCC00"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
